# EditorConfig helps maintain consistent coding styles across IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,groovy}]
indent_style = space
indent_size = 4
max_line_length = 140

[*.{xml,pom}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,md}]
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss}]
indent_style = space
indent_size = 2
