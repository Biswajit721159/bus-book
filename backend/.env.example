# ==============================================================================
# Bus Booking Microservices Environment Configuration
# ==============================================================================
# Copy this file to .env (e.g. `cp .env.example .env`) and adjust for your local
# or production environment.
# ==============================================================================

# Database Credentials
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123

# JWT Secret Key
JWT_SECRET_KEY=TaK+HaV^uvCHEFsEVfypW#7g9^k*Z8$V

# Internal Gateway Secret for downstream service verification
GATEWAY_INTERNAL_SECRET=bus-booking-internal-secret-token

# Email / SMTP Configuration (Notifications Service)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# Service Discovery / URLs (for API Gateway & inter-service calls)
USERS_SERVICE_URL=http://localhost:6005
BUS_SERVICE_URL=http://localhost:8005
BOOKING_SERVICE_URL=http://localhost:8006
PAYMENT_SERVICE_URL=http://localhost:8007

# Infrastructure
SPRING_DATA_REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Frontend URLs allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Database Connection Pool (HikariCP)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# Review Processing Cron Schedule (Local: every 1 min: 0 */1 * * * *, Prod: 2:00 AM: 0 0 2 * * *)
REVIEW_PROCESSING_CRON=0 */1 * * * *
