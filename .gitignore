target/
**/target/
build/
**/build/
dist/
**/dist/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Node & Frontend dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs
logs/
**/logs/
*.log

# Docker & Temporary Data
.docker/
tmp/
**/tmp/
.agent