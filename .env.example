# ==============================================================================
# Bus Booking Platform - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your local or production credentials:
# cp .env.example .env
# ==============================================================================

# Database Credentials
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# Service Ports & URLs
BOOKING_SERVICE_URL=http://localhost:8006
BUS_SERVICE_URL=http://localhost:8005
USERS_SERVICE_URL=http://localhost:6005
PAYMENT_SERVICE_URL=http://localhost:8007

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security & Secrets
JWT_SECRET_KEY=your_base64_256bit_jwt_secret_key_here
GATEWAY_INTERNAL_SECRET=your_internal_gateway_secret_token_here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://localhost:8080

# Review Processing Cron Schedule (Local: every 1 min: 0 */1 * * * *, Prod: 2:00 AM: 0 0 2 * * *)
REVIEW_PROCESSING_CRON=0 */1 * * * *
